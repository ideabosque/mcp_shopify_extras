# MCP Shopify Extras Test Configuration

# Base directory for dependencies
BASE_DIR=c:\Users\bibo7\gitrepo\silvaengine

# AWS Configuration
region_name=us-west-2
aws_access_key_id=YOUR_AWS_ACCESS_KEY
aws_secret_access_key=YOUR_AWS_SECRET_KEY

# Execution context
endpoint_id=test-endpoint
part_id=test-part
sales_rep=test-sales-rep
sales_rep_email=test-sales-rep@example.com

# Google Places API
google_api_key=YOUR_GOOGLE_API_KEY
keyword=YOUR_KEYWORD

# Appointment scheduling
appointment_url=https://example.com/appointment

# Shopify configuration
shop_url=YOUR_SHOP_URL
api_version=2024-01
private_app_password=YOUR_SHOPIFY_PRIVATE_APP_PASSWORD
shopify_endpoint_id=shopify_store

# Base GraphQL endpoint (AWS API Gateway or silvaengine_gateway)
endpoint=https://example.com

# --- Per-module GraphQL auth configuration ---
# Each module under graphql_modules configures its own auth. Use either
# AWS API Gateway x-api-key auth (x_api_key) or silvaengine_gateway JWT
# Bearer auth (gateway_base_url + token_username + token_password).

# ai_marketing_engine -> JWT Bearer auth via silvaengine_gateway
ai_marketing_engine_gateway_base_url=https://gateway.example.com
ai_marketing_engine_token_username=YOUR_GATEWAY_USERNAME
ai_marketing_engine_token_password=YOUR_GATEWAY_PASSWORD

# shopify_app_engine -> AWS API Gateway x-api-key auth
shopify_app_engine_x_api_key=YOUR_X_API_KEY